# 集成测试用的真实 LLM 凭据
#
# 用法：复制本文件为 .env 并填入真实值。.env 已在 .gitignore 中，不会被提交。
#   cp .env.example .env
#
# 未设置 CODE_AGENT_API_KEY 时，tests/integration/ 下的用例会自动跳过
# （通过 describe.runIf），不会导致测试失败。

# 必填：API 密钥
CODE_AGENT_API_KEY=

# 必填：厂商标识。可选 deepseek / qwen / glm / kimi / doubao / spark / ollama / custom
# baseUrl 会按此值自动推导，见 src/llm/provider-factory.ts
CODE_AGENT_PROVIDER=glm

# 必填：模型名。GLM code plan 套餐填 glm-4.6
CODE_AGENT_MODEL=glm-4.6

# 选填：覆盖自动推导的 API 端点。仅在使用代理或私有部署时需要
# CODE_AGENT_BASE_URL=
